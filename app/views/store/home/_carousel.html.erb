<div class="relative w-full" data-controller="carousel">
  <div class="relative h-[400px] md:h-[500px] overflow-hidden rounded-base">
    <% @carousel_items.each do |item| %>
      <div class="hidden duration-700 ease-in-out" data-carousel-target="slide">
        <% if item.image.attached? %>
          <%= image_tag item.image.variant(resize_to_limit: [1200, 600]),
                        class: "w-full h-full object-cover",
                        alt: item.name %>
        <% else %>
          <div class="w-full h-full bg-gray-200 flex items-center justify-center">
            <span class="text-gray-400">Sem imagem</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="absolute z-30 flex -translate-x-1/2 bottom-5 left-1/2 space-x-3">
    <% @carousel_items.each_with_index do |item, index| %>
      <button type="button"
              class="w-3 h-3 rounded-full <%= index == 0 ? 'bg-white' : 'bg-white/50' %>"
              data-carousel-target="indicator"
              data-action="click->carousel#goToSlide"
              data-index="<%= index %>"
              aria-label="Slide <%= index + 1 %>"></button>
    <% end %>
  </div>

  <button type="button"
          class="absolute top-0 start-0 z-10 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
          data-action="click->carousel#previous">
    <span class="inline-flex items-center justify-center w-10 h-10 rounded-base bg-white/30 group-hover:bg-white/50">
      <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7"/>
      </svg>
      <span class="sr-only">Previous</span>
    </span>
  </button>

  <button type="button"
          class="absolute top-0 end-0 z-10 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
          data-action="click->carousel#next">
    <span class="inline-flex items-center justify-center w-10 h-10 rounded-base bg-white/30 group-hover:bg-white/50">
      <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/>
      </svg>
      <span class="sr-only">Next</span>
    </span>
  </button>
</div>
