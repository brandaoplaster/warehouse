<tr class="border-b border-stone-100 hover:bg-stone-50">
  <td class="px-5 py-4 font-medium text-violet-600">
    #<%= order.id %>
</td>
  <td class="px-5 py-4">
    <p class="font-medium text-stone-800">
        <%= order.user.name %>
    </p>
    <p class="text-xs text-stone-500">
        <%= order.user.email %>
    </p>
  </td>
  <td class="px-5 py-4 text-stone-600">
    <%= order.products.map { |product| product.name }.join(", ") %>
    </td>
  <td class="px-5 py-4 font-semibold text-stone-800">
    <%= number_to_currency(order.total_price) %>
    </td>
  <td class="px-5 py-4">
    <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold <%= order.status %>">
      <%= order.status.capitalize %>
    </span>
  </td>
</tr>