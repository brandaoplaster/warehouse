<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-8 xl:grid-cols-4">
  <%= render "backoffice/dashboard/stat_card", label: "Revenue", value: number_to_currency(@revenue), color: "bg-green-100 text-green-700" %>
  <%= render "backoffice/dashboard/stat_card", label: "Orders", value: @orders_count, color: "bg-violet-100 text-violet-700" %>
  <%= render "backoffice/dashboard/stat_card", label: "Products Sold", value: @products_sold, color: "bg-orange-100 text-orange-700" %>
  <%= render "backoffice/dashboard/stat_card", label: "Customers", value: @customers_count, color: "bg-blue-100 text-blue-700" %>
</div>
